{
  "name": "cast-language-server",
  "version": "2.1.2",
  "description": "Language Server Protocol (LSP) implementation for the Cast Template Engine (.cast.php)",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "cast-language-server": "dist/server.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --test dist/test/*.test.js dist/php/test/*.test.js"
  },
  "keywords": [
    "lsp",
    "language-server",
    "cast",
    "php",
    "template"
  ],
  "author": "Cast Template Engine Team",
  "license": "MIT",
  "dependencies": {
    "cast-language-core": "file:../language-core",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8",
    "web-tree-sitter": "^0.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
