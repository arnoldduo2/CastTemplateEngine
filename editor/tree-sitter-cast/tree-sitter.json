{
  "grammars": [
    {
      "name": "cast",
      "camelcase": "Cast",
      "scope": "source.cast",
      "path": ".",
      "file-types": [
        "cast.php"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ],
      "injection-regex": "^(cast|cast\\.php)$"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Cast template engine (.cast.php)",
    "authors": [
      {
        "name": "Cast Template Engine Team"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-cast"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
